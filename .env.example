# Copie este arquivo para .env na raiz do repositorio e ajuste os caminhos.
# Use caminhos absolutos. Diretorios de entrada devem existir.
# Multiplos diretorios em CIRCUIT_DIRS e TEST_DIRS sao separados por ponto e virgula.

# Destino dos projetos, IPs e arquivos gerados pelas ferramentas.
RTDS_ROOT=/caminho/absoluto/rtds-gerados

# Pastas pesquisadas recursivamente pelos menus de circuitos.
CIRCUIT_DIRS=/caminho/absoluto/circuitos

# Pastas pesquisadas pelo menu de imagens de boot de teste.
TEST_DIRS=/caminho/absoluto/testes
